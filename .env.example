# Copy to .env and fill in. Never commit .env.
# Enable the Message Content intent so /bind can read DM replies.
# Commands are global and DM-only. The first sync can take up to an hour to appear.
# To use the bot without a shared server, enable User Install for the application
# in the Discord developer portal. Otherwise the bot must share a server with you.

DISCORD_TOKEN=

# Fernet key. Generate one with:
# py -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this separate from var/bot.db. Losing it makes the score cache unreadable.
BOT_ENCRYPTION_KEY=

# Optional comma-separated Discord user ids.
# Empty means anyone who can DM the bot can use it and bind their own account.
# Set this to restrict the bot to you and your friends.
ALLOWED_USER_IDS=

# How long the encrypted score cache is kept. The session token is memory-only either way.
CACHE_TTL_HOURS=24

# Optional. Required for /reload-data when the Discord application is team-owned.
OWNER_ID=
