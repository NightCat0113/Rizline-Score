# Copy to .env and fill in. Never commit .env.
# The bot requests the Message Content intent. Enable it in the developer portal
# or Discord will reject the login.
# Commands are global. They work in servers, DMs, and group chats.
# The first sync can take up to an hour to appear.
# To use the bot without a shared server, enable User Install for the application
# in the Discord developer portal. Otherwise the bot must share a server with you.

DISCORD_TOKEN=

# Fernet key. Generate one with:
# py -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this separate from var/bot.db. Losing it makes the score cache unreadable.
BOT_ENCRYPTION_KEY=

# Optional comma-separated Discord user ids.
# Empty means anyone who can use the bot can run commands and bind their own account.
# Set this to restrict the bot to you and your friends.
ALLOWED_USER_IDS=

# How long the encrypted score cache is kept.
# Rizline sessions are also stored encrypted (14-day TTL, refreshed on live calls).
CACHE_TTL_HOURS=24

# Optional. Required for owner commands when the Discord application is team-owned.
OWNER_ID=

# Optional. On Altare (no UnityPy/download cache), /refresh-game-data starts a
# GitHub Actions workflow instead of running the pipeline on the bot host.
# Create a fine-grained PAT with Actions: Read and write on this repo, or a
# classic PAT with the "workflow" scope. Never commit the token.
GITHUB_TOKEN=
GITHUB_REPOSITORY=NightCat0113/Rizline-Score
GITHUB_REF=main
GITHUB_REFRESH_WORKFLOW=refresh-game-data.yml
